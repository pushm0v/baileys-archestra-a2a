# Base URL of your Archestra platform (no trailing slash)
ARCHESTRA_URL=http://localhost:3000

# Agent to invoke (Agent Triggers > Webhook / A2A shows the agent ID)
ARCHESTRA_AGENT_ID=

# Personal, team or organization token with access to the agent
ARCHESTRA_TOKEN=

# Comma-separated phone numbers (country code, no +) allowed to talk to the agent.
# Leave empty to allow anyone (not recommended).
ALLOWED_NUMBERS=6281234567890

# Where WhatsApp session credentials and chat->contextId map are stored
DATA_DIR=./data

# Max time to wait for a synchronous agent reply (ms)
AGENT_TIMEOUT_MS=300000

# Which attachment kinds to forward: image, document, audio, video, sticker
MEDIA_TYPES=image,document

# Largest attachment to forward (MB)
MAX_MEDIA_MB=10

# How to send binary files to the agent:
#   auto   - send as A2A file parts; if Archestra rejects them, describe files as text from then on
#   always - always try file parts (fall back per message on rejection)
#   never  - never send bytes; describe binary files as text
MEDIA_INLINE=auto

# pino log level for Baileys: fatal | error | warn | info | debug | trace
LOG_LEVEL=warn
