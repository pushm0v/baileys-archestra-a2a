{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsapp-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",

  "vars": {
    // Default admins: always allowed to sign in, and can't be removed from the dashboard.
    // Comma-separated emails (Google or Zitadel). More admins can be added in the dashboard.
    "ADMIN_EMAILS": "you@example.com",
    // Only accounts with an email from these domains can sign in (comma-separated, e.g. "kitabisa.com").
    // Anyone from them who signs in appears on the Users page, waiting for an admin to give them a role.
    // Leave empty to allow any domain; then only users an admin has invited can sign in.
    // ADMIN_EMAILS can always sign in.
    "ALLOWED_DOMAINS": "kitabisa.com",
    // Sign-in providers: set up Google, Zitadel, or both. The login page offers the ones configured here.
    // OAuth client ID from Google Cloud Console > APIs & Services > Credentials (not secret). Empty turns Google off.
    "GOOGLE_CLIENT_ID": "",
    // Zitadel instance URL, e.g. "https://auth.example.com" (the issuer). Empty turns Zitadel off.
    "ZITADEL_ISSUER": "",
    // Client ID of the Zitadel web application (not secret)
    "ZITADEL_CLIENT_ID": "",
    // Button text on the login page, e.g. "Kitabisa SSO"
    "ZITADEL_LABEL": "Zitadel",
    // Optional: let Zitadel project roles decide dashboard roles, e.g. "admin=wa-admin, operator=wa-operator, viewer=wa-viewer".
    // Checked at every Zitadel sign-in. Empty: Zitadel users get roles on the Users page, like Google users.
    "ZITADEL_ROLE_MAPPING": "",
    // Recorded WhatsApp messages older than this many days are deleted every night. "0" keeps them forever.
    "MESSAGE_RETENTION_DAYS": "0"
  },
  // Runs the message retention cleanup once a day
  "triggers": { "crons": ["17 3 * * *"] },
  // Set with `wrangler secret put NAME` (or in .dev.vars locally):
  //   SESSION_SECRET         random string used to sign session cookies (e.g. openssl rand -base64 32)
  //   GOOGLE_CLIENT_SECRET   Google OAuth client secret, when Google sign-in is on
  //   ZITADEL_CLIENT_SECRET  only for a Zitadel app with the "Basic" auth method; leave unset for a "PKCE" app
  "secrets": { "required": ["SESSION_SECRET"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whatsapp-dashboard",
      // wrangler d1 create whatsapp-dashboard, then paste the ID here
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // One hub holds the runner and browser WebSockets and the live status of every number
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],

  // The Worker runs first so it can require sign-in before serving the app
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
