# Runner settings for `docker compose --profile runner up -d runner` (copy to .env.runner).
# The runner runs every WhatsApp number assigned to it in the dashboard.

# Dashboard URL (the Cloudflare Worker), and the token shown when you added this runner there
DASHBOARD_URL=https://whatsapp-dashboard.example.workers.dev
RUNNER_TOKEN=

# Defaults for numbers that don't set their own Archestra URL / token env var in the dashboard
ARCHESTRA_URL=http://host.docker.internal:9000
ARCHESTRA_TOKEN=

# More tokens: a number or route in the dashboard refers to them by name (e.g. SALES_TOKEN).
# Tokens never leave this host; the dashboard only stores the variable name.
# SALES_TOKEN=

# Archestra behind a private CA (put the PEM in ./certs)
# NODE_EXTRA_CA_CERTS=/certs/ca.pem

# pino log level for Baileys: fatal | error | warn | info | debug | trace
LOG_LEVEL=warn
